# Copy this file to .env for a local, non-production configuration.
PORT=8787
SEALEDCASH_SERVICE_TOKEN=replace-with-a-long-random-local-token
SEALEDCASH_RELAYER_KEY=replace-with-a-local-test-key
SEALEDCASH_RPC_URL=https://replace-with-an-rpc-endpoint
SEALEDCASH_CHAIN_ID=replace-with-chain-id
SEALEDCASH_POOL_ADDRESS=0x0000000000000000000000000000000000000000
SEALEDCASH_MAX_GAS=800000
SEALEDCASH_IDEMPOTENCY_TTL_MS=900000
SEALEDCASH_LOG_LEVEL=info